<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="djaramilloExamen.Views.vRegistro"
             Title="Registro">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label x:Name="lblUsuario" Text="Usuario conectado: "/>

            <Label Text="REGISTRO"
                   TextColor="Blue"
                   FontSize="22"
                   HorizontalOptions="Center"/>

            <!-- Datos personales -->
            <Grid RowSpacing="5" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre" Grid.Row="0" Grid.Column="0"/>
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1"/>
                <Label Text="Edad" Grid.Row="0" Grid.Column="2"/>

                <Entry x:Name="txtNombre" Placeholder="Ingresar Nombre" TextChanged="SoloLetras_TextChanged" Grid.Row="1" Grid.Column="0"/>
                <Entry x:Name="txtApellido" Placeholder="Ingresar Apellido" TextChanged="SoloLetras_TextChanged" Grid.Row="1" Grid.Column="1"/>
                <Entry x:Name="txtEdad" Placeholder="Ingresar Edad" Keyboard="Numeric" MaxLength="3" TextChanged="SoloNumeros_TextChanged" Grid.Row="1" Grid.Column="2"/>
            </Grid>

            <!-- Datos de la membresia -->
            <Grid RowSpacing="10" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Fecha de inicio:" Grid.Row="0" Grid.Column="0"/>
                <DatePicker x:Name="dpFecha" Format="dd/MM/yyyy" Grid.Row="0" Grid.Column="1"/>

                <Label Text="Plan:" Grid.Row="1" Grid.Column="0"/>
                <Picker x:Name="pkPlan" Title="Seleccione" Grid.Row="1" Grid.Column="1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Casillero:" Grid.Row="2" Grid.Column="0"/>
                <Switch x:Name="swCasillero" HorizontalOptions="Start" Grid.Row="2" Grid.Column="1"/>

                <Label Text="Monto Inicial:" Grid.Row="3" Grid.Column="0"/>
                <Entry x:Name="txtMonto" Placeholder="120 - 600" Keyboard="Numeric" TextChanged="SoloDecimales_TextChanged" Grid.Row="3" Grid.Column="1"/>

                <Button x:Name="btnCalcular"
                        Text="Calcular Pago mensual"
                        Clicked="btnCalcular_Clicked"
                        Grid.Row="4" Grid.Column="0"/>
                <Entry x:Name="txtPago" Placeholder="Pago mensual" IsReadOnly="True" Grid.Row="4" Grid.Column="1"/>
            </Grid>

            <Button x:Name="btnVerResumen"
                    Text="Ver Resumen"
                    Clicked="btnVerResumen_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
