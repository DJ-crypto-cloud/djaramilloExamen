<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="djaramilloExamen.Views.vAcercaDe"
             Title="Acerca de">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="ACERCA DE"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Nombre: Dylan Jaramillo" Style="{StaticResource EtiquetaGlobal}"/>
            <Label Text="Carrera: CARRERA" Style="{StaticResource EtiquetaGlobal}"/>
            <Label Text="Paralelo: A" Style="{StaticResource EtiquetaGlobal}"/>

            <Button x:Name="btnVolver"
                    Text="Volver"
                    Style="{StaticResource BotonGlobal}"
                    Clicked="btnVolver_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
